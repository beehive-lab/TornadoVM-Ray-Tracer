<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <repositories>
        <repository>
            <id>universityOfManchester-graal</id>
            <url>
                https://raw.githubusercontent.com/beehive-lab/tornado/maven-tornadovm
            </url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-api</artifactId>
            <version>${tornadovm.version}</version>
        </dependency>
    </dependencies>

    <groupId>com.vinhderful</groupId>
    <artifactId>tornadovm-ray-tracer</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <tornadovm.base.version>5.0.0</tornadovm.base.version>
        <!-- Locally-built jdk27-jvmci-removal branch revision (see build-test-matrix.sh in that
             repo: it builds and installs 5.2.1-jdkNN-dev for JDK 21/25/26/27 alike). The jdk21/
             jdk25/jdk26/jdk27 profiles below all compose their tornadovm.version from this, so
             bumping the branch's revision only needs a change here. -->
        <tornadovm.dev.version>5.2.1</tornadovm.dev.version>
        <!-- Defaults (overridden by the JDK profiles below) -->
        <jdk.version.suffix>-jdk25</jdk.version.suffix>
        <tornadovm.version>${tornadovm.base.version}${jdk.version.suffix}</tornadovm.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ─── JDK 21 ───────────────────────────────────────────────────────────
             Auto-activates for JDK 21.x builds.
             TornadoVM: pinned to the locally-built ${tornadovm.dev.version}-jdk21-dev
             artifacts, matching the jdk25/jdk26/jdk27 profiles below - not the published
             5.0.0-jdk21 (which predates the Serializable Task interfaces the
             SerializedLambda-based kernel resolution on this branch relies on).
        ─────────────────────────────────────────────────────────────────────── -->
        <profile>
            <id>jdk21</id>
            <activation><jdk>[21,25)</jdk></activation>
            <properties>
                <maven.compiler.release>21</maven.compiler.release>
                <jdk.version.suffix>-jdk21</jdk.version.suffix>
                <tornadovm.version>${tornadovm.dev.version}${jdk.version.suffix}-dev</tornadovm.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <!-- The FFM API backing TornadoVM's native arrays is a preview API in
                                 Java 21 (final since Java 22), so the jdk21 TornadoVM jars are
                                 compiled with enable-preview and consumers must compile with it too. -->
                            <compilerArgs>
                                <arg>--enable-preview</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ─── JDK 25 ───────────────────────────────────────────────────────────
             Auto-activates for JDK 25.0.2 through 25.x builds (minimum required version).
             Capped below 26 so JDK 26+ builds fall through to the jdk26/jdk27 profiles
             below instead of silently compiling against the jdk25 tornado-api (which
             predates the Serializable Task interfaces the reflection-based runtime path
             on JDK 26+ relies on — see TaskUtils.resolveViaSerializedLambda upstream).
             TornadoVM: pinned to the locally-built ${tornadovm.dev.version}-jdk25-dev
             artifacts (same reasoning as jdk21 above), not the published 5.0.0-jdk25.
        ─────────────────────────────────────────────────────────────────────── -->
        <profile>
            <id>jdk25</id>
            <activation><jdk>[25.0.2,26)</jdk></activation>
            <properties>
                <maven.compiler.release>25</maven.compiler.release>
                <jdk.version.suffix>-jdk25</jdk.version.suffix>
                <tornadovm.version>${tornadovm.dev.version}${jdk.version.suffix}-dev</tornadovm.version>
            </properties>
        </profile>

        <!-- ─── JDK 26 ───────────────────────────────────────────────────────────
             Auto-activates for JDK 26.x builds. JVMCI still ships on JDK 26 but its SPI
             has drifted from the JDK-21 shape TornadoVM's reflection providers compile
             against, so TornadoVM's launcher overlays a frozen JDK-21 jvmci jar via the
             patch-module flag (self.jvmci_patched in tornado.py) and resolves kernel entry
             lambdas via SerializedLambda instead of hidden-class bytecode — the same
             Serializable Task interfaces the jdk27 profile below needs.
             TornadoVM: pinned to the locally-built ${tornadovm.dev.version}-jdk26-dev
             artifacts (no published 5.0.0-jdk26 release exists).
        ─────────────────────────────────────────────────────────────────────── -->
        <profile>
            <id>jdk26</id>
            <activation><jdk>[26,27)</jdk></activation>
            <properties>
                <maven.compiler.release>26</maven.compiler.release>
                <jdk.version.suffix>-jdk26</jdk.version.suffix>
                <tornadovm.version>${tornadovm.dev.version}${jdk.version.suffix}-dev</tornadovm.version>
            </properties>
        </profile>

        <!-- ─── JDK 27 ───────────────────────────────────────────────────────────
             Auto-activates for JDK 27+ builds (JVMCI fully removed upstream,
             openjdk/jdk#30834 — see TornadoVM's own jdk27 profile and JDK27-NO-JVMCI.md).
             TornadoVM: pinned to the locally-built ${tornadovm.dev.version}-jdk27-dev
             artifacts (no published 5.0.0-jdk27 release exists).
             No enable-preview flag needed: the FFM API is final on JDK 27, and this
             project's sources don't reference jdk.incubator.vector directly (only
             TornadoVM's own runtime jar does, at runtime, via the launcher's
             add-modules ALL-SYSTEM).
        ─────────────────────────────────────────────────────────────────────── -->
        <profile>
            <id>jdk27</id>
            <activation><jdk>[27,)</jdk></activation>
            <properties>
                <maven.compiler.release>27</maven.compiler.release>
                <jdk.version.suffix>-jdk27</jdk.version.suffix>
                <tornadovm.version>${tornadovm.dev.version}${jdk.version.suffix}-dev</tornadovm.version>
            </properties>
        </profile>
    </profiles>

</project>
