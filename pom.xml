<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <repositories>
        <repository>
            <id>universityOfManchester-graal</id>
            <url>
                https://raw.githubusercontent.com/beehive-lab/tornado/maven-tornadovm
            </url>
        </repository>
    </repositories>
    <dependencies>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-fxml</artifactId>
            <version>21</version>
        </dependency>
        <dependency>
            <groupId>io.github.beehive-lab</groupId>
            <artifactId>tornado-api</artifactId>
            <version>${tornadovm.version}</version>
        </dependency>
    </dependencies>

    <groupId>com.vinhderful</groupId>
    <artifactId>tornadovm-ray-tracer</artifactId>
    <version>1.0-SNAPSHOT</version>

    <properties>
        <tornadovm.base.version>5.0.0</tornadovm.base.version>
        <!-- Locally-built jdk27-jvmci-removal branch revision (see build-test-matrix.sh in that
             repo: it builds and installs 5.2.1-jdkNN-dev for JDK 21/25/26/27 alike). The jdk21/
             jdk25/jdk26/jdk27 profiles below all compose their tornadovm.version from this, so
             bumping the branch's revision only needs a change here. -->
        <tornadovm.dev.version>5.2.1</tornadovm.dev.version>
        <!-- Defaults (overridden by the JDK profiles below) -->
        <jdk.version.suffix>-jdk25</jdk.version.suffix>
        <tornadovm.version>${tornadovm.base.version}${jdk.version.suffix}</tornadovm.version>
        <maven.compiler.release>25</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- ─── JDK 21 ───────────────────────────────────────────────────────────
             Auto-activates for JDK 21.x builds.
             TornadoVM: pinned to the locally-built ${tornadovm.dev.version}-jdk21-dev
             artifacts, matching the jdk25/jdk26/jdk27 profiles below - not the published
             5.0.0-jdk21 (which predates the Serializable Task interfaces the
             SerializedLambda-based kernel resolution on this branch relies on).
        ─────────────────────────────────────────────────────────────────────── -->
        <profile>
            <id>jdk21</id>
            <activation><jdk>[21,22)</jdk></activation>
            <properties>
                <maven.compiler.release>21</maven.compiler.release>
                <jdk.version.suffix>-jdk21</jdk.version.suffix>
                <tornadovm.version>${tornadovm.dev.version}${jdk.version.suffix}-dev</tornadovm.version>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <!-- The FFM API backing TornadoVM's native arrays is a preview API in
                                 Java 21 (final since Java 22), so the jdk21 TornadoVM jars are
                                 compiled with enable-preview and consumers must compile with it too. -->
                            <compilerArgs>
                                <arg>--enable-preview</arg>
                            </compilerArgs>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- ─── JDK 22+ ──────────────────────────────────────────────────────────
             Auto-activates for JDK 22 and newer. TornadoVM consolidated its old
             per-version jdk25/jdk26/jdk27 dev profiles into one "jdk22plus" SDK
             build that runs unchanged on 22, 23, ..., 27 and later (see
             build-test-matrix.sh in the jdk27-jvmci-removal TornadoVM branch: it now
             builds and installs a single 5.2.1-jdk22plus-dev for JDK 22-27 alike,
             replacing the former per-version 5.2.1-jdkNN-dev artifacts) - so one
             profile here (replacing the former jdk25/jdk26/jdk27 profiles) covers
             the whole open-ended range too, including the JVMCI-removed JDK 27+
             case the old jdk27 profile called out separately.
             No enable-preview flag needed: the FFM API is final since JDK 22, and
             this project's sources don't reference jdk.incubator.vector directly
             (only TornadoVM's own runtime jar does, at runtime, via the launcher's
             add-modules ALL-SYSTEM) - same reasoning the old jdk27 profile gave.
             TornadoVM: pinned to the locally-built ${tornadovm.dev.version}-jdk22plus-dev
             artifact, not a published release (no 5.2.1 GA exists yet at all).
        ─────────────────────────────────────────────────────────────────────── -->
        <profile>
            <id>jdk22plus</id>
            <activation><jdk>[22,)</jdk></activation>
            <properties>
                <maven.compiler.release>22</maven.compiler.release>
                <jdk.version.suffix>-jdk22plus</jdk.version.suffix>
                <tornadovm.version>${tornadovm.dev.version}${jdk.version.suffix}-dev</tornadovm.version>
            </properties>
        </profile>
    </profiles>

</project>
